cat > .gitignore <<'EOF'
# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Model weights
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Hugging Face/model cache
.cache/
huggingface/

# Large mech-interp artifacts
activations/
results/raw/
results/data/*
!results/data/.gitkeep

# Logs
results/logs/*
!results/logs/.gitkeep

# IDE
.vscode/

# OS
.DS_Store
EOF

touch results/data/.gitkeep
touch results/logs/.gitkeep